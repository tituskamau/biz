---
export interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { class: className = '', size = 'md' } = Astro.props;

const sizeClasses = {
  sm: 'size-5',
  md: 'size-6',
  lg: 'size-8'
};
---

<div class:list={[sizeClasses[size], 'text-primary', className]}>
    <img 
    src="/assets/img/BI_Logo.jpg" 
    alt="Custom Icon" 
    class="w-full h-full"
  />
</div>